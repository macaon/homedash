# Optional. Copy to .env and edit: cp .env.example .env
# Docker/Podman Compose reads .env automatically. Every value has a default, so HomeDash also starts without one.

# Where you reach the dashboard in a browser, exactly as typed (scheme and host, no trailing slash).
# Set this when it sits behind a reverse proxy; it is used for sign-in redirects.
HOMEDASH_PUBLIC_URL=http://127.0.0.1:8790

# Published address and port. Loopback by default; use a private interface address if a proxy on another host needs access.
HOMEDASH_BIND=127.0.0.1
HOMEDASH_PORT=8790

# Your reverse proxy's address or network (comma-separated), e.g. 172.28.0.1. Only requests from it may name the real
# client in X-Forwarded-For, which sign-in limits rely on. Leave empty if there is no proxy.
HOMEDASH_TRUSTED_PROXIES=

# Optional single sign-on. Can also be configured in the UI under Server settings.
# HOMEDASH_OIDC_ISSUER=
# HOMEDASH_OIDC_CLIENT_ID=
# HOMEDASH_OIDC_CLIENT_SECRET_FILE=

# Optional. Leave unset to build the image locally. To pull a prebuilt image from your own registry instead,
# name it here and run `docker compose pull`.
# HOMEDASH_IMAGE=registry.example.net/homedash:latest
